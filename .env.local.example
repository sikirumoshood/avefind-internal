# Note: the port this app itself listens on is NOT set here — Next loads
# .env.local after it has already bound to a port. Use a real shell env var
# instead: `PORT=4000 npm run dev` (Next reads PORT natively).

# Base URLs for each avefind-backend microservice (no shared API gateway).
# See ../avefind-backend/docker-compose.yml for local ports.
AUTH_SERVICE_URL=http://localhost:3001
ORDERS_SERVICE_URL=http://localhost:3002
PAYMENTS_SERVICE_URL=http://localhost:4001
ANALYTICS_SERVICE_URL=http://localhost:4002
LOGISTICS_SERVICE_URL=http://localhost:4004

# CDN in front of the private S3 bucket, used to resolve *S3Key fields (e.g. Banner.imageS3Key) to viewable image URLs.
NEXT_PUBLIC_ASSET_BASE_URL=https://d3fz32v9ube9lf.cloudfront.net

# --- Production (uncomment to point this app at prod instead of local) ---
# Each service's own routes are already prefixed with its name (/auth/..., /orders/...,
# /payments/...), so this assumes prod fronts all five behind one host (api.avefind.com)
# with a reverse proxy routing by that path prefix. VERIFY against the actual prod
# topology before relying on this — if instead each service has its own subdomain or
# port in prod, these five lines need distinct hosts, not one shared value.
# AUTH_SERVICE_URL=https://api.avefind.com
# ORDERS_SERVICE_URL=https://api.avefind.com
# PAYMENTS_SERVICE_URL=https://api.avefind.com
# ANALYTICS_SERVICE_URL=https://api.avefind.com
# LOGISTICS_SERVICE_URL=https://api.avefind.com
#
# NEXT_PUBLIC_ASSET_BASE_URL is the same CDN in every environment — no override needed here.
